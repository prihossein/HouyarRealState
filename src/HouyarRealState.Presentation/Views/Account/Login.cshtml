@{
    Layout = null;
}

<!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Html.Raw("ورود به سیستم")</title>
    <link rel="stylesheet" type="text/css" href="/iofrm/css/farsi-font.css">
    <link rel="stylesheet" type="text/css" href="/iofrm/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="/iofrm/css/fontawesome-all.min.css">
    <link rel="stylesheet" type="text/css" href="/iofrm/css/iofrm-style-1.css">
    <link rel="stylesheet" type="text/css" href="/iofrm/css/iofrm-theme17.css">
    <link href="/css/customlogin.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/material-design-iconic-font/2.2.0/css/material-design-iconic-font.min.css">

    <link href="/plugins/toastr/toastr.min.css" rel="stylesheet" />
    <link href="/plugins/font-awesome-4.7.0/css/font-awesome.css" rel="stylesheet" />
</head>
<body>
    <div class="form-body without-side">
        <div class="website-logo">
            <a href="/">
                <div class="logo">
                    <img class="logo-size" src="/img/logo.png" alt="">
                </div>
            </a>
        </div>
        <div class="row">
            <div class="img-holder">
                <div class="bg" style="background-image: url('/img/gif/@ViewBag.RandomBackground');"></div>
                <div class="info-holder">
                    <img src="/iofrm/images/graphic3.svg" alt="">
                </div>
            </div>
            <div class="form-holder">
                <div class="form-content">
                    <div class="form-items">
                        <h3 class="form-items-title">ورود به سیستم</h3>
                        <form id="frmLogin" method="post">
                            <input name="returnUrl" type="hidden" value="@ViewBag.ReturnUrl">

                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">
                                        <i class="zmdi zmdi-smartphone-android"></i>
                                    </span>
                                </div>

                                <input class="form-control" id="UserName" name="UserName" autocomplete="off" type="text" placeholder="نام کاربری">

                            </div>

                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">
                                        <i class="zmdi zmdi-eye"></i>
                                        <i class="zmdi zmdi-eye-off hidden"></i>
                                    </span>
                                </div>
                                <input type="password" class="form-control" placeholder="رمز عبور" name="Password" id="Password" aria-label="Password" aria-describedby="Password">
                            </div>

                            <div class="form-button">

                                <button id="submitWating" disabled class="ibtn submitWating hidden">
                                    <span>
                                        <i class='fa fa-spinner fa-spin'></i>
                                    </span>
                                    در حال احراز هویت کاربر
                                </button>
                                <button id="submit" type="submit" class="ibtn submit">ورود</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/iofrm/js/jquery.min.js"></script>
    <script src="/iofrm/js/popper.min.js"></script>
    <script src="/iofrm/js/bootstrap.min.js"></script>
    <script src="/iofrm/js/main.js"></script>
    <script src="/js/login.js"></script>
    <script src="/plugins/toastr/toastr.min.js"></script>

</body>
</html>
