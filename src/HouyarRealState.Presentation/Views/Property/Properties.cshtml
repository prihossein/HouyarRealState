@using HouyarRealState.Application.DTOs
@using HouyarRealState.Application.DTOs.Properties
@model PropertyForDashboardDTO


@{
    ViewData["Title"] = "ملک‌ها";
}

<div class="container-fluid">
    <div class="row page-titles mx-0">
        <div class="col-sm-6 p-md-0">
            <div class="welcome-text">
                <h4>@ViewData["Title"]</h4>
            </div>
        </div>
        <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@Html.Raw("داشبورد")</a></li>
                <li class="breadcrumb-item active"><a href="javascript:void(0)">@ViewData["Title"]</a></li>
            </ol>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="card">
                <div class="card-header filter-area">
                    <h4 class="card-title">@Html.Raw("فیلتر ملک‌ها")</h4>
                </div>
                <div class="card-body filter-body hide-area">
                    <div class="basic-form">
                        <form>

                            <div class="form-row">
                                <div class="form-group col-md-12">
                                    <label for="filterTitle">@Html.Raw("عنوان ملک")</label>
                                    <input type="text" class="form-control" name="filterTitle" id="filterTitle" value="@ViewBag.filterTitle" placeholder="@Html.Raw("نام ملک")">
                                </div>
                            </div>

                            <div class="form-row">


                                <div class="form-group col-md-4">
                                    <label for="filterPropertyTypeId">@Html.Raw("نوع ملک")</label>
                                    <select id="filterPropertyTypeId" name="filterPropertyTypeId" class="form-control">
                                        <option>همه</option>
                                        @foreach (var propertyType in Model.PropertyTypes)
                                        {
                                            <option  value="@propertyType.Id">@propertyType.Title</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-group col-md-4">
                                    <label for="filterTransactionTypeId">@Html.Raw("نوع معامله")</label>
                                    <select id="filterTransactionTypeId" name="filterTransactionTypeId" class="form-control">
                                        <option>همه</option>
                                        @foreach (var transactionType in Model.TransactionTypes)
                                        {
                                            <option value="@transactionType.Id">@transactionType.Title</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-group col-md-4">
                                    <label for="filterPropertyRequestId">@Html.Raw("نوع درخواست")</label>
                                    <select id="filterPropertyRequestId" name="filterPropertyRequestId" class="form-control">
                                        <option>همه</option>
                                        @foreach (var propertyRequestType in Model.PropertyRequestTypes)
                                        {
                                            <option value="@propertyRequestType.Id">@propertyRequestType.Title</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <a asp-controller="Property" asp-action="Properties" class="btn btn-default">@Html.Raw("بدون فیلتر")</a>
                            <button type="submit" class="btn btn-primary">@Html.Raw("فیلتر کردن")</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="card">
        <div class="card-header d-sm-flex d-block">
            <div class="mr-auto mb-sm-0 mb-3">
                <h4 class="card-title mb-2">@Html.Raw("لیست ملک‌ها")</h4>
                <span><b>@Html.Raw("تعداد کل ملک‌ها: ")</b>@Model.CountProperties</span>
            </div>

            <a asp-controller="Property" asp-action="ExportPropertiesToExcel" class="btn btn-outline-success mb-2 mr-2">
                @Html.Raw("خروجی اکسل")
                <svg width="24px" height="24px" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><title>file_type_excel2</title><path d="M28.781,4.405H18.651V2.018L2,4.588V27.115l16.651,2.868V26.445H28.781A1.162,1.162,0,0,0,30,25.349V5.5A1.162,1.162,0,0,0,28.781,4.405Zm.16,21.126H18.617L18.6,23.642h2.487v-2.2H18.581l-.012-1.3h2.518v-2.2H18.55l-.012-1.3h2.549v-2.2H18.53v-1.3h2.557v-2.2H18.53v-1.3h2.557v-2.2H18.53v-2H28.941Z" style="fill:#20744a;fill-rule:evenodd" /><rect x="22.487" y="7.439" width="4.323" height="2.2" style="fill:#20744a" /><rect x="22.487" y="10.94" width="4.323" height="2.2" style="fill:#20744a" /><rect x="22.487" y="14.441" width="4.323" height="2.2" style="fill:#20744a" /><rect x="22.487" y="17.942" width="4.323" height="2.2" style="fill:#20744a" /><rect x="22.487" y="21.443" width="4.323" height="2.2" style="fill:#20744a" /><polygon points="6.347 10.673 8.493 10.55 9.842 14.259 11.436 10.397 13.582 10.274 10.976 15.54 13.582 20.819 11.313 20.666 9.781 16.642 8.248 20.513 6.163 20.329 8.585 15.666 6.347 10.673" style="fill:#ffffff;fill-rule:evenodd" /></svg>
            </a>

            <a asp-controller="Property" asp-action="AddProperty" class="btn btn-info">@Html.Raw("افزودن ملک +")</a>
        </div>
        <div class="card-body">
            @if (Model.Properties.Item1.Count() > 0)
            {
                <div class="table-responsive" style="height:500px;">
                    <table class="table table-sm mb-0 table-striped">
                        <thead>
                            <tr>
                                <th>@Html.Raw("منو")</th>
                                <th>@Html.Raw("تاریخ انتشار")</th>
                                <th>@Html.Raw("عنوان")</th>
                                <th>@Html.Raw("سوالات متداول")</th>
                                <th>@Html.Raw("بازدید")</th>
                                <th>@Html.Raw("وضعیت")</th>
                                <th>@Html.Raw("تعداد کلمات")</th>
                                <th>@Html.Raw("لینک داخلی")</th>
                                <th>@Html.Raw("لینک خارجی")</th>
                            </tr>
                        </thead>
                        <tbody id="customers">

                            @foreach (var item in Model.Properties.Item1)
                            {
                                <tr class="btn-reveal-trigger">
                                    <td class="py-2">
                                        <div class="dropdown">
                                            <button class="btn btn-primary tp-btn-light sharp" type="button" data-toggle="dropdown"><span class="fs--1"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="18px" height="18px" viewBox="0 0 24 24" version="1.1"><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><rect x="0" y="0" width="24" height="24"></rect><circle fill="#000000" cx="5" cy="12" r="2"></circle><circle fill="#000000" cx="12" cy="12" r="2"></circle><circle fill="#000000" cx="19" cy="12" r="2"></circle></g></svg></span></button>
                                            <div class="dropdown-menu dropdown-menu-right border py-0">
                                                <div class="py-2">
                                                    <a class="dropdown-item" href="javascript:void(0);" asp-route-propertyId="@item.Id" data-toggle="modal" data-target="#update-modal">@Html.Raw("ویرایش") </a>
                                                    <a class="dropdown-item text-danger btn-delete" href="javascript:void(0);" id="@item.Id" data-toggle="modal" data-target="#delete-modal">حذف</a>
                                                </div>
                                            </div>
                                        </div>
                                    </td>


                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.Properties.Item2 > 1)
                {
                    PagingViewModel pagingModel = ViewBag.Paging as PagingViewModel;
                    <partial name="_PagingAdmin" model="pagingModel" />
                }
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>@Html.Raw("ملکی برای نمایش وجود ندارد")</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="delete-modal">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Html.Raw("حذف ملک")</h5>
                <button type="button" class="close" data-dismiss="modal"><span>×</span></button>
            </div>
            <div class="modal-body">
                <h5><i class="fa fa-warning text-danger"></i> @Html.Raw("آیا از حذف این ملک اطمینان دارید؟")</h5>
                <p>@Html.Raw("توجه داشته باشید ملک حذف شده، غیر قابل بازیابی می باشد!")</p>
            </div>
            <div class="modal-footer">

                <button type="button" class="btn btn-danger light" data-dismiss="modal">بستن</button>
                <form id="frmDelete" method="post">
                    <input type="hidden" id="propertyId" name="propertyId" />
                    <button type="submit" class="btn btn-danger">@Html.Raw("حذف ملک")</button>
                </form>

            </div>
        </div>
    </div>
</div>


@section _Scripts {
    <script src="/js/properties.js"></script>
}