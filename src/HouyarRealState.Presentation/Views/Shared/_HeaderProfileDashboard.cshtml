@using Microsoft.AspNetCore.Identity
@using HouyarRealState.Domain.Entities.User
@inject UserManager<ApplicationUser> _userManager

@{
    var user = await _userManager.FindByNameAsync(User.Identity?.Name);
}

<li class="nav-item dropdown header-profile">
    <a class="nav-link" href="#" role="button" data-toggle="dropdown">

        <img src="/zenix/images/Untitled-1.jpg" width="20" alt="@Html.Raw($"{user.FullName}")" />


        <div class="header-info">

            <span>@Html.Raw($"{user.FullName}") </span>

        </div>
    </a>
    <div class="dropdown-menu dropdown-menu-right">
        <a asp-area="UserPanel" asp-controller="UserPanel" asp-action="UserPanel" class="dropdown-item ai-icon">
            <svg id="icon-user1"
                 xmlns="http://www.w3.org/2000/svg"
                 width="18"
                 height="18"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span class="ml-2">@Html.Raw("پنل کاربری")</span>
        </a>

        <a href="/Logout" class="dropdown-item ai-icon text-danger">
            <svg id="icon-logout"
                 xmlns="http://www.w3.org/2000/svg"
                 class="text-danger"
                 width="18"
                 height="18"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>

            <span class="ml-2">@Html.Raw("خروج")</span>
        </a>
    </div>
</li>